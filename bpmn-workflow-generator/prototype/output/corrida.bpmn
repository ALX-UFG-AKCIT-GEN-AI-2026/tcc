<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Form" targetNamespace="http://bpmn.io/schema/bpmn" exporter="MotorBPMN" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Corrida" processRef="corrida_1"/>
  </bpmn:collaboration>
  <bpmn:process id="corrida_1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Pista">
        <bpmn:flowNodeRef>start_corrida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>correndo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pulando</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start_corrida" name="Começar corrida"/>
    <bpmn:userTask id="correndo" name="Correndo"/>
    <bpmn:userTask id="pulando" name="Pulando"/>
    <bpmn:endEvent id="fim" name="Terminar corrida"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start_corrida" targetRef="correndo"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="correndo" targetRef="pulando"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="correndo" targetRef="fim"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="pulando" targetRef="correndo"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="120" y="100" width="2000" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true">
        <dc:Bounds x="150" y="100" width="1970" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_corrida_di" bpmnElement="start_corrida">
        <dc:Bounds x="220" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="correndo_di" bpmnElement="correndo">
        <dc:Bounds x="460" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pulando_di" bpmnElement="pulando">
        <dc:Bounds x="700" y="180" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fim_di" bpmnElement="fim">
        <dc:Bounds x="700" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="256" y="220"/>
        <di:waypoint x="460" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="560" y="220"/>
        <di:waypoint x="700" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="560" y="220"/>
        <di:waypoint x="700" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="800" y="220"/>
        <di:waypoint x="460" y="220"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
