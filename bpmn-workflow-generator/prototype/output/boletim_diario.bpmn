<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Form" targetNamespace="http://bpmn.io/schema/bpmn" exporter="MotorBPMN" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Boletim Diário" processRef="1"/>
  </bpmn:collaboration>
  <bpmn:process id="1" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Pauteiro">
        <bpmn:flowNodeRef>inicio_multiplo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_viabilidade_pauta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frente_descartar_pauta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>estabelecer_agenda_repor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fim_processo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Repórter">
        <bpmn:flowNodeRef>apuracao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_frente_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>frente_descartar_pauta_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_espera_tempo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>espera_tempo</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Edição e revisão">
        <bpmn:flowNodeRef>frente_sistematizar_matérias</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>edicao_recebe_matéria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>editar_matéria</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revisar_orografia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revisar_homologar_boletim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Envio e postagem">
        <bpmn:flowNodeRef>envio_postagem_cadastra_diagramacao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>enviar_email_publico_alvo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cadastrar_portal_redes_sociais</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="inicio_multiplo" name=""/>
    <bpmn:exclusiveGateway id="gateway_viabilidade_pauta" name="É viável realizar a pauta?"/>
    <bpmn:userTask id="frente_descartar_pauta" name="Descartar pauta e encerrar o processo"/>
    <bpmn:userTask id="estabelecer_agenda_repor" name="Estabelecer agenda de pautas e encaminhar para o repórter"/>
    <bpmn:userTask id="apuracao" name="Apuração"/>
    <bpmn:exclusiveGateway id="gateway_frente_1" name=""/>
    <bpmn:userTask id="frente_descartar_pauta_2" name="Descartar pauta e fim"/>
    <bpmn:exclusiveGateway id="gateway_espera_tempo" name="O tempo de espera é viável?"/>
    <bpmn:intermediateCatchEvent id="espera_tempo" name="Espera Tempo"/>
    <bpmn:userTask id="frente_sistematizar_matérias" name="Sistematizar as matérias, escrever matéria para a edição"/>
    <bpmn:userTask id="edicao_recebe_matéria" name="A edição recebe a matéria"/>
    <bpmn:userTask id="editar_matéria" name="Editar matéria"/>
    <bpmn:userTask id="revisar_orografia" name="Revisar ortografia"/>
    <bpmn:userTask id="envio_postagem_cadastra_diagramacao" name="Envio e postagem cadastra e diagramação"/>
    <bpmn:userTask id="revisar_homologar_boletim" name="Revisar e homologar boletim"/>
    <bpmn:userTask id="enviar_email_publico_alvo" name="Enviar por e-mail para o público alvo"/>
    <bpmn:userTask id="cadastrar_portal_redes_sociais" name="Cadastrar no portal e redes sociais"/>
    <bpmn:endEvent id="fim_processo" name=""/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="inicio_multiplo" targetRef="gateway_viabilidade_pauta"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="gateway_viabilidade_pauta" targetRef="frente_descartar_pauta" name="Não"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="gateway_viabilidade_pauta" targetRef="estabelecer_agenda_repor" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="frente_descartar_pauta" targetRef="fim_processo"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="estabelecer_agenda_repor" targetRef="apuracao"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="apuracao" targetRef="gateway_frente_1"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="gateway_frente_1" targetRef="frente_descartar_pauta_2"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="gateway_frente_1" targetRef="gateway_espera_tempo"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="frente_descartar_pauta_2" targetRef="fim_processo"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="gateway_espera_tempo" targetRef="fim_processo" name="Não"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="gateway_espera_tempo" targetRef="espera_tempo" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="espera_tempo" targetRef="frente_sistematizar_matérias"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="frente_sistematizar_matérias" targetRef="edicao_recebe_matéria"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="edicao_recebe_matéria" targetRef="editar_matéria"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="editar_matéria" targetRef="revisar_orografia"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="revisar_orografia" targetRef="envio_postagem_cadastra_diagramacao"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="envio_postagem_cadastra_diagramacao" targetRef="revisar_homologar_boletim"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="revisar_homologar_boletim" targetRef="enviar_email_publico_alvo"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="enviar_email_publico_alvo" targetRef="cadastrar_portal_redes_sociais"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="cadastrar_portal_redes_sociais" targetRef="fim_processo"/>
  </bpmn:process>
